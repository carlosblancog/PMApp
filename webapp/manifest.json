{
  "_version": "1.58.0",
  "sap.app": {
    "id": "com.alk.pmregistration",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "PM Time Registration Approval",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "pmService": {
        "uri": "/sap/opu/odata/sap/ZITS_PM_SRV/",
        "type": "OData",
        "settings": { "odataVersion": "2.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": false }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.alk.pmregistration.view.Main",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "resources": {
      "css": [{ "uri": "css/style.css" }]
    },
    "models": {
      "": {
        "dataSource": "pmService",
        "preload": true,
        "settings": {
          "useBatch": false,
          "refreshAfterChange": false
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.alk.pmregistration.i18n.i18n"
        }
      }
    }
  }
}
