<mvc:View
    controllerName="com.alk.pmregistration.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <App>
        <Page
            id="mainPage"
            title="Project Manager Approvals – {localModel>/period}"
            titleAlignment="Center"
            busy="{localModel>/busy}"
            busyIndicatorDelay="0"
            showNavButton="false">

            <subHeader>
                <Toolbar>
                    <SearchField
                        placeholder="{i18n>searchPlaceholder}"
                        search="onSearch"
                        width="20rem" />
                    <ToolbarSpacer />
                    <Button
                        icon="sap-icon://refresh"
                        tooltip="{i18n>refreshTooltip}"
                        press="onRefresh" />
                </Toolbar>
            </subHeader>

            <content>
                <MessageStrip
                    text="{i18n>accessDenied}"
                    type="Error"
                    showCloseButton="false"
                    visible="{localModel>/accessDenied}"
                    class="sapUiSmallMargin" />

                <IconTabBar
                    id="filterBar"
                    visible="{localModel>/accessGranted}"
                    select="onFilterSelect"
                    expandable="false"
                    class="sapUiNoContentPadding">
                    <items>
                        <IconTabFilter key="all" icon="sap-icon://show-all"
                            text="{i18n>filterAll}" count="{localModel>/filterCounts/all}"
                            tooltip="{i18n>filterAllTooltip}" />
                        <IconTabSeparator />
                        <IconTabFilter key="unreleased" icon="sap-icon://alert" iconColor="Critical"
                            text="{i18n>filterUnreleased}" count="{localModel>/filterCounts/unreleased}"
                            tooltip="{i18n>filterUnreleasedTooltip}" />
                        <IconTabFilter key="released" icon="sap-icon://accept" iconColor="Positive"
                            text="{i18n>filterReleased}" count="{localModel>/filterCounts/released}"
                            tooltip="{i18n>filterReleasedTooltip}" />
                        <IconTabSeparator />
                        <IconTabFilter key="approved" icon="sap-icon://thumb-up" iconColor="Positive"
                            text="{i18n>filterApproved}" count="{localModel>/filterCounts/approved}"
                            tooltip="{i18n>filterApprovedTooltip}" />
                        <IconTabFilter key="pending" icon="sap-icon://pending"
                            text="{i18n>filterPending}" count="{localModel>/filterCounts/pending}"
                            tooltip="{i18n>filterPendingTooltip}" />
                    </items>
                </IconTabBar>

                <List
                    id="projectList"
                    visible="{localModel>/accessGranted}"
                    noDataText="{i18n>noData}"
                    showSeparators="None"
                    items="{localModel>/projects}">
                    <items>
                        <CustomListItem type="Inactive">
                            <content>
                                <VBox class="pmkProjectBlock">

                                    <!-- Project header row -->
                                    <Toolbar class="pmkProjectHeader">
                                        <CheckBox
                                            selected="{localModel>isSelected}"
                                            select="onProjectSelect" />
                                        <core:Icon
                                            src="sap-icon://project-definition-triangle"
                                            size="1.25rem"
                                            color="{= ${localModel>notReleasedCount} > 0 ? 'Negative' : (${localModel>isFullyApproved} ? 'Positive' : 'Critical') }"
                                            class="sapUiSmallMarginEnd" />
                                        <Text text="{localModel>projectName}" class="pmkProjectCode" />
                                        <Text text="{localModel>projectDesc}" class="pmkProjectDescText" />
                                        <ToolbarSpacer />
                                        <Text text="{localModel>totalHours} h" class="pmkTotalHoursHeader" />
                                        <ToolbarSeparator />
                                        <ObjectStatus
                                            icon="sap-icon://alert"
                                            text="{localModel>notReleasedCount} not released"
                                            state="Warning"
                                            class="pmkStatusLarge"
                                            visible="{= ${localModel>notReleasedCount} > 0}" />
                                        <ObjectStatus
                                            icon="sap-icon://accept"
                                            text="All released"
                                            state="Success"
                                            class="pmkStatusLarge"
                                            visible="{= ${localModel>notReleasedCount} === 0}" />
                                        <ToolbarSeparator />
                                        <ObjectStatus
                                            icon="{= ${localModel>isFullyApproved} ? 'sap-icon://accept' : 'sap-icon://pending' }"
                                            text="{= ${localModel>isFullyApproved} ? 'Approved' : 'Pending' }"
                                            state="{= ${localModel>isFullyApproved} ? 'Success' : 'None' }"
                                            class="pmkStatusLarge sapUiSmallMarginBegin" />
                                    </Toolbar>

                                    <!-- Detail rows -->
                                    <Table
                                        items="{localModel>rows}"
                                        mode="None"
                                        showSeparators="Inner"
                                        backgroundDesign="Transparent"
                                        class="pmkDetailTable">
                                        <columns>
                                            <Column width="25%"><Text text="{i18n>colEmployee}" /></Column>
                                            <Column width="25%"><Text text="{i18n>colSubtask}" /></Column>
                                            <Column width="12%" hAlign="Center"><Text text="{i18n>colOpexCapex}" /></Column>
                                            <Column width="10%" hAlign="End"><Text text="{i18n>colHours}" /></Column>
                                            <Column width="14%" hAlign="Center"><Text text="{i18n>colReleased}" /></Column>
                                            <Column width="14%" hAlign="Center"><Text text="{i18n>colApproved}" /></Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem type="Inactive">
                                                <cells>
                                                    <HBox alignItems="Center">
                                                        <core:Icon
                                                            src="sap-icon://employee"
                                                            size="1.25rem"
                                                            color="{= ${localModel>isReleased} ? 'Positive' : 'Negative' }"
                                                            class="sapUiTinyMarginEnd"
                                                            visible="{= !${localModel>isTotal}}" />
                                                        <Title text="{localModel>employeeName}" level="H6" wrapping="false"
                                                            visible="{= !${localModel>isTotal}}" />
                                                        <core:Icon
                                                            src="sap-icon://sum"
                                                            size="1rem"
                                                            color="Neutral"
                                                            class="sapUiTinyMarginEnd"
                                                            visible="{= ${localModel>isTotal}}" />
                                                        <Text text="{localModel>employeeName}"
                                                            visible="{= ${localModel>isTotal}}" />
                                                    </HBox>
                                                    <Text text="{localModel>displayName}" />
                                                    <Text text="{localModel>opexCapex}" />
                                                    <ObjectNumber
                                                        number="{localModel>totalHours}"
                                                        unit="h"
                                                        state="Information"
                                                        emphasized="true" />
                                                    <HBox>
                                                        <ObjectStatus
                                                            icon="{= ${localModel>isReleased} ? 'sap-icon://accept' : 'sap-icon://decline' }"
                                                            text="{= ${localModel>isReleased} ? 'Yes' : 'No' }"
                                                            state="{= ${localModel>isReleased} ? 'Success' : 'Error' }"
                                                            visible="{= !${localModel>isTotal}}" />
                                                    </HBox>
                                                    <HBox>
                                                        <ObjectStatus
                                                            icon="{= ${localModel>isApproved} ? 'sap-icon://accept' : 'sap-icon://pending' }"
                                                            text="{= ${localModel>isApproved} ? 'Yes' : 'No' }"
                                                            state="{= ${localModel>isApproved} ? 'Success' : 'None' }"
                                                            visible="{= !${localModel>isTotal}}" />
                                                    </HBox>
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>

                                </VBox>
                            </content>
                        </CustomListItem>
                    </items>
                </List>
            </content>

            <footer>
                <Toolbar visible="{localModel>/accessGranted}">
                    <ToolbarSpacer />
                    <Button
                        text="Approve selected ({localModel>/selectedCount})"
                        type="Emphasized"
                        enabled="{= ${localModel>/selectedCount} > 0}"
                        press="onApprove" />
                </Toolbar>
            </footer>

        </Page>
    </App>

</mvc:View>
